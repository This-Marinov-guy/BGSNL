# Reference only: merge these keys into .env.development.local.
# Never put signing credentials under public/ or in NEXT_PUBLIC_* variables.
WALLET_TEST_BASE_URL=http://localhost:3000
APPLE_WALLET_TEAM_ID=826Q79398Y
APPLE_WALLET_PASS_TYPE_ID=pass.nl.bulgariansociety.membership.test
APPLE_WALLET_CERT_PATH=.wallet-local/apple/pass-cert.pem
APPLE_WALLET_KEY_PATH=.wallet-local/apple/pass-key.pem
APPLE_WALLET_WWDR_PATH=.wallet-local/apple/wwdr.pem
GOOGLE_WALLET_ISSUER_ID=3388000000023197450
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=.wallet-local/google/service-account.json

# Enable only after the public /c/ route and backend have been deployed and tested.
WALLET_ISSUANCE_ENABLED=0
GOOGLE_WALLET_ISSUER_ACCESS_VERIFIED=0
GOOGLE_WALLET_PUBLISHING_APPROVED=0
# Production secret stores can provide file contents encoded as base64 instead of paths:
# APPLE_WALLET_CERT_BASE64, APPLE_WALLET_KEY_BASE64, APPLE_WALLET_WWDR_BASE64
# GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64
# APPLE_WALLET_KEY_PASSPHRASE (only for encrypted private keys)
