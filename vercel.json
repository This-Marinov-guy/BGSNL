{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "master": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/archive-events",
      "schedule": "15 3 * * *"
    }
  ]
}
